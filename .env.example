# ---- Target -----------------------------------------------------------------
# Linktree username to scrape. This is the only change needed to point the app
# at a different seller: https://linktr.ee/<LINKTREE_USERNAME>
LINKTREE_USERNAME=ChelitoSAF

# ---- Freshness --------------------------------------------------------------
# Content updates only when you press "Update now" (or run `npm run refresh`).
# After this many hours the status dot turns amber; after three times this, red.
STALE_AFTER_HOURS=24

# ---- Politeness -------------------------------------------------------------
# Delay between consecutive ManaBox deck fetches, in milliseconds. One update is
# roughly (deck count x this delay); at 1200ms and 63 decks that is ~2 minutes.
FETCH_DELAY_MS=1200
FETCH_TIMEOUT_MS=20000
FETCH_RETRIES=2

# ---- Server / storage -------------------------------------------------------
PORT=3000
DB_PATH=data/mtg.db

# ---- Public deployments only --------------------------------------------------
# Shared secret required by POST /api/refresh and GET /api/metrics (the /stats
# page). Leave blank for local use; set it on anything reachable from the
# internet, or strangers can trigger scrapes and read your search stats.
# Generate with: openssl rand -hex 24
REFRESH_TOKEN=
