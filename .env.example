# Only needed for running the scraper locally. GitHub Actions uses the defaults.

# Linktree username to scrape. This is the only change needed to point the app
# at a different seller: https://linktr.ee/<LINKTREE_USERNAME>
LINKTREE_USERNAME=ChelitoSAF

# Delay between consecutive ManaBox deck fetches, in milliseconds. One build is
# roughly (deck count x this delay); at 1200ms and 63 decks that is ~2 minutes.
FETCH_DELAY_MS=1200
FETCH_TIMEOUT_MS=20000
FETCH_RETRIES=2
