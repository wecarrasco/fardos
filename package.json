{
  "name": "mtg-card-search",
  "version": "0.1.0",
  "private": true,
  "description": "Search every ManaBox deck on a seller's Linktree for a given MTG card",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:index": "tsx scripts/build-index.ts",
    "serve:site": "python3 -m http.server 4173 --directory dist-site",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "scrape:linktree": "tsx src/cli/scrape-linktree.ts",
    "scrape:deck": "tsx src/cli/scrape-deck.ts",
    "fixtures:update": "tsx scripts/update-fixtures.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
